{
  "name": "computer-history",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint && npx eslint .",
    "lint:swift": "./scripts/lint-swift.sh",
    "typecheck": "pnpm -r --if-present build && pnpm -r --if-present typecheck",
    "daemon": "pnpm --filter @computer-history/daemon dev",
    "app": "cd apps/recorder-macos && swift build",
    "fixtures:sync": "./scripts/sync-fixtures.sh",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:swift && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.35.0"
  },
  "description": "Experimental macOS activity history, searchable recall, and a local daemon",
  "license": "MIT"
}
